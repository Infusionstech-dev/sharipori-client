NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Storefront contact details. Empty values hide their links.
NEXT_PUBLIC_ANNOUNCEMENT=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
# Digits with country code, for example 8801XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_MESSENGER_URL=

# Image hosts next/image may resize, comma separated, for example res.cloudinary.com
NEXT_PUBLIC_IMAGE_HOSTS=
